  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "Правозахисна організація сиріт \"Віра в майбутнє\"",
        "meta_descr": "Наше покликання допомагати сиротам тому що Правозахисна організація сиріт \"Віра в майбутнє\" створена колишніми випускниками шкіл-інтернатів для дітей-сиріт та дітей, позбавлених батьківського піклування.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": ""
      },
      "components": [
        {
          "_inherit": "msg-box5",
          "_params": {
            "showTitle": false,
            "showMeta": false,
            "showText": true,
            "showButtons": false,
            "inverse": false,
